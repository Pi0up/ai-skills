  "HOME": {
    "code": "HOME",
    "title": "Accueil & Sélections Éco-Responsables",
    "url": "/",
    "template": "HOME",
    "access": "public",
    "roles": [
      "ANONYMOUS",
      "VOYAGEUR",
      "HOTE",
      "ADMIN"
    ],
    "ctx_in": {},
    "ctx_out": {
      "utm_source": "STRING",
      "session_id": "UUID"
    },
    "tracking": {
      "pageview": "/home",
      "events": [
        "click_search",
        "click_featured_lodge",
        "filter_ecolabel_hero"
      ]
    },
    "notes": "Vitrine d'entrée principale. Observabilité totale via pixel et GTM."
  },
  "H001": {
    "code": "H001",
    "title": "Espace Voyageur (Hub)",
    "url": "/account",
    "template": "H",
    "subtype": "hub",
    "access": "protected",
    "roles": [
      "VOYAGEUR",
      "ADMIN"
    ],
    "ctx_in": {
      "auth_token": "JWT"
    },
    "ctx_out": {
      "user_id": "UUID"
    },
    "tracking": {
      "pageview": "/account"
    },
    "notes": "Nœud intermédiaire routant vers la première sous-page (Mes Réservations)."
  },
  "L002": {
    "code": "L002",
    "title": "Mes Réservations",
    "url": "/account/bookings",
