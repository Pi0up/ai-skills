%% ==============================================================================
%% Template Userflow - Parcours Déplié (Sous-parcours expansé)
%% Conforme à : spec-userflows.md (v2.1, Section 9 & 10)
%% Cas d'usage : UC-DOSSIER | Objectif : OBJ-DOSSIER-01 | Parcours : PF-DOSSIER-NOM
%%
%% Dépliage du CALL PF-DOSSIER-PJ-SEG :
%%   - ND-040 : ECR F010
%%   - ND-041 : ACT FEAT-TELEVERSER
%%   - ND-042 : ATT Contrôle des pièces ⏸ (Rupture déclarée)
%%   - ND-043 : ECR F010:CONTROLE
%% ==============================================================================

flowchart LR

    %% --------------------------------------------------------------------------
    %% Étape amont de l'appelant
    %% --------------------------------------------------------------------------
    ND010(["ND-010 ECR C010:EDIT"])
    ND011["ND-011 ACT FEAT-VALIDER-INFOS"]

    ND010 --> ND011

    %% --------------------------------------------------------------------------
    %% Sous-parcours appelé (PF-DOSSIER-PJ-SEG déplié dans son subgraph)
    %% --------------------------------------------------------------------------
    subgraph Sub_PJ["CALL PF-DOSSIER-PJ-SEG (Déplié)"]
        direction LR
        ND040(["ND-040 ECR F010"])
        ND041["ND-041 ACT FEAT-TELEVERSER"]
        ND042{{"ND-042 ATT Contrôle pièces ⏸"}}
        ND043(["ND-043 ECR F010:CONTROLE"])

        ND040 --> ND041
        ND041 --> ND042
        ND042 --> ND043
    end

    %% Transition vers l'entrée du sous-parcours (CTX-IN garanti)
    ND011 --> ND040

    %% --------------------------------------------------------------------------
    %% Écran d'atterrissage et suite de l'appelant
    %% --------------------------------------------------------------------------
    ND020(["ND-020 ECR C010"])
    ND021["ND-021 ACT FEAT-SOUMETTRE"]

    %% Transition depuis la sortie du sous-parcours (CTX-OUT garanti)
    ND043 --> ND020
    ND020 --> ND021

    %% --------------------------------------------------------------------------
    %% Classes & Styles
    %% --------------------------------------------------------------------------
    classDef ecrNode fill:#e3f2fd,stroke:#1976d2,stroke-width:1.5px;
    classDef actNode fill:#f1f8e9,stroke:#558b2f,stroke-width:1.5px;
    classDef attNode fill:#fff8e1,stroke:#f57f17,stroke-width:1.5px;
    classDef extNode fill:#ede7f6,stroke:#512da8,stroke-width:1.5px;
    classDef nonObsNode stroke-dasharray: 4 4;

    class ND010,ND020,ND040,ND043 ecrNode;
    class ND011,ND021,ND041 actNode;
    class ND042 attNode;
