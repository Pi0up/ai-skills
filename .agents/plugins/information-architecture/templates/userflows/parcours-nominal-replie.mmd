%% ==============================================================================
%% Template Userflow - Parcours Nominal (Vue Repliée)
%% Conforme à : spec-userflows.md (v2.1, Section 9 & 10)
%% Cas d'usage : UC-DOSSIER | Objectif : OBJ-DOSSIER-01 | Parcours : PF-DOSSIER-NOM
%%
%% Formes de nœuds conformes :
%%   - ECR : ([stade arrondi]) avec référence technique canonique (R-04)
%%   - ACT : [rectangle] avec FEAT en majuscules (Section 6.8)
%%   - ATT : {{hexagone}} avec ⏸ si rupture
%%   - EXT : [/parallélogramme/] avec ⏸ si rupture
%%   - CALL: [[sous-routine / double bord]]
%% ==============================================================================

flowchart LR

    %% --------------------------------------------------------------------------
    %% Séquence linéaire du parcours nominal
    %% Chaque étape est un événement (ECR, ACT, ATT, EXT ou CALL)
    %% --------------------------------------------------------------------------

    ND010(["ND-010 ECR C010:EDIT"])
    ND011["ND-011 ACT FEAT-VALIDER-INFOS"]
    PJ[["CALL PF-DOSSIER-PJ-SEG"]]
    ND020(["ND-020 ECR C010"])
    ND021["ND-021 ACT FEAT-SOUMETTRE"]

    %% Enchaînement linéaire (P3 : pas de bifurcation interne)
    ND010 --> ND011
    ND011 --> PJ
    PJ --> ND020
    ND020 --> ND021

    %% --------------------------------------------------------------------------
    %% Classes & Styles
    %% --------------------------------------------------------------------------
    classDef ecrNode fill:#e3f2fd,stroke:#1976d2,stroke-width:1.5px;
    classDef actNode fill:#f1f8e9,stroke:#558b2f,stroke-width:1.5px;
    classDef attNode fill:#fff8e1,stroke:#f57f17,stroke-width:1.5px;
    classDef extNode fill:#ede7f6,stroke:#512da8,stroke-width:1.5px;
    classDef callNode fill:#fce4ec,stroke:#c2185b,stroke-width:2px;
    classDef nonObsNode stroke-dasharray: 4 4;

    class ND010,ND020 ecrNode;
    class ND011,ND021 actNode;
    class PJ callNode;
