---
title: Sitemap Overview
type: sitemap
id: sitemap-overview
version: 1.0.0
roles: [ANONYMOUS, AUTH]
tags: [sitemap, overview, architecture]
description: Template d'arborescence générale (niveau macro)
---
flowchart TD

    %% --------------------------------------------------------------------------
    %% 1. Racine (HOME)
    %% Règle : Unique, URL '/', code sans ID
    %% --------------------------------------------------------------------------
    HOME["home<br/>/"]

    %% --------------------------------------------------------------------------
    %% 2. Pages publiques / Zone accessible ANONYMOUS
    %% Codes templates : L (Liste), C (Contenu), F (Formulaire), H (Hub)
    %% Conventions URL : minuscules, pluriel pour listes, variables [id]
    %% --------------------------------------------------------------------------
    subgraph ZonePublique["Zone Publique (Accès : ANONYMOUS, ...)"]
        direction TB
        L001["search-results<br/>search-results/"]
        L002["products<br/>products/"]
        C001["product-detail<br/>[id]/"]
        F001["login<br/>login/"]
        E001["error-404<br/>404/"]
    end

    %% --------------------------------------------------------------------------
    %% 3. Zone protégée (ANONYMOUS exclu de 'access')
    %% --------------------------------------------------------------------------
    subgraph ZoneProtegee["Zone Protégée (Accès authentifié requis)"]
        direction TB
        D001["account<br/>account/"]
        H001["workspace<br/>workspace/"]
        L003["workspace-projects<br/>projects/"]
        C002["project-detail<br/>[id]/"]
        F003["project-new<br/>new/"]
    end

    %% --------------------------------------------------------------------------
    %% 4. Hiérarchie de l'Arbre (Parent unique par page, sauf HOME)
    %% --------------------------------------------------------------------------
    HOME --> L001
    HOME --> L002
    HOME --> F001
    HOME --> E001
    HOME --> D001
    HOME --> H001

    L002 --> C001
    H001 --> L003
    L003 --> C002
    L003 --> F003

    %% --------------------------------------------------------------------------
    %% 5. Modules Transverses (Hors Arbre)
    %% Règle : Code M, pas de parent, portée ALL/PUBLIC/AUTH/@ROLE
    %% Invoqué via '!invocation' sur l'URL courante
    %% --------------------------------------------------------------------------
    subgraph ModulesTransverses["Modules Transverses (Hors Arbre)"]
        direction TB
        M001["M001 !help-panel [Portée: ALL]"]
        M002["M002 !user-preferences [Portée: AUTH]"]
    end
