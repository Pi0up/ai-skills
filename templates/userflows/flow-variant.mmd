%% ==============================================================================
%% Template Userflow - Parcours avec Variante & Nœuds Non Observables
%% Conforme à : spec-userflows.md (v2.1, Sections 1.P3, 4, 5, 9, 10)
%% Cas d'usage : UC-DOSSIER | Objectif : OBJ-DOSSIER-01
%%
%% Règles clés :
%%   - Chaque parcours est linéaire
%%   - La variante bifurque (diverge_de) et rejoint (rejoint)
%%   - Nœud non observable tracé avec bordure en pointillés (nonObsNode)
%%   - Rupture déclarée indiquée par ⏸ dans le libellé
%% ==============================================================================

flowchart LR

    %% --------------------------------------------------------------------------
    %% Parcours Nominal : PF-DOSSIER-NOM (Trait plein)
    %% Contexte d'entrée : Données complètes
    %% --------------------------------------------------------------------------
    ND010(["ND-010 ECR C010:EDIT"])
    ND011["ND-011 ACT FEAT-VALIDER-INFOS"]
    ND020(["ND-020 ECR C010"])
    ND021["ND-021 ACT FEAT-SOUMETTRE"]

    ND010 --> ND011
    ND011 --> ND020
    ND020 --> ND021

    %% --------------------------------------------------------------------------
    %% Parcours Variante : PF-DOSSIER-VAR-ASSIST (Trait pointillé)
    %% diverge_de: PF-DOSSIER-NOM@1 | rejoint: PF-DOSSIER-NOM@4
    %% Contexte d'entrée : Pièces manquantes + assistance demandée
    %% Inclut un événement hors application observable de manière indirecte (EXT avec clé de retour) + rupture ⏸
    %% --------------------------------------------------------------------------
    ND030["ND-030 ACT FEAT-DEMANDER-AIDE"]
    ND031[/"ND-031 EXT Échange téléphonique conseiller ⏸"/]

    ND010 -. "diverge_de @1" .-> ND030
    ND030 -.-> ND031
    ND031 -. "rejoint @4 (Clé de retour)" .-> ND020

    %% --------------------------------------------------------------------------
    %% Classes & Styles
    %% --------------------------------------------------------------------------
    classDef ecrNode fill:#e3f2fd,stroke:#1976d2,stroke-width:1.5px;
    classDef actNode fill:#f1f8e9,stroke:#558b2f,stroke-width:1.5px;
    classDef attNode fill:#fff8e1,stroke:#f57f17,stroke-width:1.5px;
    classDef extNode fill:#ede7f6,stroke:#512da8,stroke-width:1.5px;
    classDef nonObsNode stroke-dasharray: 4 4;

    class ND010,ND020 ecrNode;
    class ND011,ND021,ND030 actNode;
    class ND031 extNode;
