%% ==============================================================================
%% Template Arborescence - Niveau Détaillé
%% Conforme à : spec-arborescence.md (v0.3, Section 3.2, 5, 6, 11)
%% Complète le niveau général avec :
%%   - Les variantes d'écrans (CODE@ROLE:VARIANT)
%%   - Les ancres internes (#) et popins/prompts (!)
%%   - Les renvois fonctionnels (FEAT-XXX) entre pages
%%   - Les invocations de modules transverses (!cle)
%% ==============================================================================

flowchart TD

    %% --------------------------------------------------------------------------
    %% 1. Structure Hiérarchique Principale
    %% --------------------------------------------------------------------------
    HOME["HOME /"]
    L001["L001 /search-results"]
    L002["L002 /products"]
    C001["C001 /products/[id]"]
    F001["F001 /login"]
    D001["D001 /account (protégée)"]
    F002["F002 /checkout (protégée)"]

    HOME --> L001
    HOME --> L002
    HOME --> F001
    HOME --> D001
    HOME --> F002
    L002 --> C001

    %% --------------------------------------------------------------------------
    %% 2. Ancres internes (#) et Popins rattachées (!)
    %% Règle : Rattachées à la page, non autonomes (Table composants_page)
    %% --------------------------------------------------------------------------
    subgraph Sub_C001["Composants rattachés à C001"]
        direction TB
        C001_ANC["#reviews (Avis clients)"]
        C001_POP["!quick-view (Aperçu rapide)"]
    end
    C001 -.-> C001_ANC
    C001 -.-> C001_POP

    %% --------------------------------------------------------------------------
    %% 3. Variantes de pages (Grammaire : CODE[@ROLE][:VARIANT])
    %% Déclarées dans la table `variantes`
    %% --------------------------------------------------------------------------
    subgraph Variantes_C001["Variantes déclarées pour C001"]
        direction TB
        C001_BUYER["C001@BUYER (Consultation acheteur)"]
        C001_ADMIN_EDIT["C001@ADMIN:EDIT (Édition catalogue)"]
    end
    C001 === Variantes_C001

    %% --------------------------------------------------------------------------
    %% 4. Modules Transverses (Code M, Hors Arbre)
    %% Invocables depuis les pages autorisées
    %% --------------------------------------------------------------------------
    subgraph ModulesTransverses["Modules Transverses (Hors Arbre)"]
        direction TB
        M001["M001 !help-panel [Portée: ALL]"]
        M002["M002 !user-preferences [Portée: AUTH]"]
    end

    %% Invocations de modules depuis des pages
    C001 -. "!help-panel" .-> M001
    D001 -. "!user-preferences" .-> M002

    %% --------------------------------------------------------------------------
    %% 5. Renvois Fonctionnels (Table `renvois`)
    %% Navigation transversale déclenchée par une fonctionnalité (FEAT-XXX)
    %% Syntaxe : source -. "FEAT-XXX" .-> cible
    %% --------------------------------------------------------------------------
    C001_BUYER -. "FEAT-COMMANDER" .-> F002
    L001 -. "FEAT-OUVRIR-PRODUIT" .-> C001

    %% --------------------------------------------------------------------------
    %% Classes & Styles
    %% --------------------------------------------------------------------------
    classDef homeNode fill:#e1f5fe,stroke:#0288d1,stroke-width:2px,font-weight:bold;
    classDef protectedNode fill:#fbe9e7,stroke:#d84315,stroke-width:1.5px;
    classDef moduleNode fill:#f3e5f5,stroke:#7b1fa2,stroke-width:1.5px,stroke-dasharray: 3 3;
    classDef subElemNode fill:#f5f5f5,stroke:#9e9e9e,stroke-width:1px,stroke-dasharray: 2 2;
    classDef variantNode fill:#fff8e1,stroke:#fbc02d,stroke-width:1.5px;

    class HOME homeNode;
    class D001,F002 protectedNode;
    class M001,M002 moduleNode;
    class C001_ANC,C001_POP subElemNode;
    class C001_BUYER,C001_ADMIN_EDIT variantNode;
